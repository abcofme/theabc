# The main domain is an entry point in Moscow. The destination subdomains never
# run this rule, so a VPN change or an unknown IP cannot cause a redirect loop.
(geo_entry) {
	@geo_entry {
		host {$SITE_DOMAIN}
		method GET HEAD
		path /
	}
	handle @geo_entry {
		header {
			Cache-Control "no-store"
			Content-Type "text/html; charset=utf-8"
		}
		@russian {
			import ru-ips.caddy
		}
		handle @russian {
			header Location https://direct.{$SITE_DOMAIN}{uri}
			respond "<!doctype html><html lang='ru'><meta charset='utf-8'><title>Азбука Я</title><p><a href='https://direct.{$SITE_DOMAIN}/'>Открыть приложение</a></p><p><a href='https://db-ip.com/'>IP Geolocation by DB-IP</a> · CC BY 4.0</p></html>" 302
		}
		handle {
			header Location https://app.{$SITE_DOMAIN}{uri}
			respond "<!doctype html><html lang='ru'><meta charset='utf-8'><title>Азбука Я</title><p><a href='https://app.{$SITE_DOMAIN}/'>Открыть приложение</a></p><p><a href='https://db-ip.com/'>IP Geolocation by DB-IP</a> · CC BY 4.0</p></html>" 302
		}
	}
}
