{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		# Служебный API бота с тестами — только с его сервера (SERVICE_ALLOWED_IPS в .env)
		@service_foreign {
			path /api/service/*
			not remote_ip {$SERVICE_ALLOWED_IPS:127.0.0.1}
		}
		respond @service_foreign 403

		reverse_proxy api:8000 {
			# Генерация ИИ отдаёт ответ потоком (пробелы-пинги, потом JSON): не буферизуем
			flush_interval -1
		}
	}

	handle {
		root * /srv

		# Файлы сборки с хэшем в имени не меняются — кэшируем навсегда
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
